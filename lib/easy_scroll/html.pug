.es_scroll_containter(:data-es-theme="resolvedTheme")
    .es_scroll_box(ref="boxRef", :class="$attrs.class")        
        .es_scroll_content.es_smooth_scroll(
            ref="ulRef", :class="['', {es_back_scroll: runtimeData.back}]", 
            :style="{ transform: `translate(${displayScrollX}px, ${displayScrollY}px)` }"
        )
            Hint(v-if="showHint")
                template(v-for="(_, name) in filterSlots('hint')", :key="name", #[name]="slotProps")
                    slot(:name="name", v-bind="slotProps")
            slot
    // 滚动条仅在对应轴有内容溢出时显示
    ScrollBar(v-if="scrollBar && scrollAxis != 'x' && runtimeData.maxScroll.y > 0", 
        scroll="y", :scrollJoy="scrollJoy", :scrollInside="scrollInside", :scrollReverse="scrollReverse",
        :teleport="teleport"
    )
    ScrollBar(v-if="scrollBar && scrollAxis != 'y' && runtimeData.maxScroll.x > 0", 
        scroll="x", :scrollJoy="scrollJoy", :scrollInside="scrollInside", :scrollReverse="scrollReverse",
        :teleport="teleport"
    )
    Cursor(v-if="midMouseNav && scrollCtrl.midnav?.active", 
        :start="scrollCtrl.midnav.startPos", 
        :pos="scrollCtrl.midnav.cursorPos"
    )