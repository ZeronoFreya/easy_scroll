.es_scroll_containter(ref="boxRef", :data-es-theme="resolvedTheme", :class="$attrs.class",
    @mouseenter="scrollUi.setContainerHover(true)", @mouseleave="scrollUi.setContainerHover(false)",
    @mousemove="scrollUi.resetIdle")
    .es_scroll_box     
        .es_scroll_content.es_smooth_scroll(
            ref="ulRef", :class="['', {es_back_scroll: runtimeData.back}]", 
            :style="{ transform: `translate(${displayScrollX}px, ${displayScrollY}px)` }"
        )
            Hint(v-if="showHint")
                template(v-for="(_, name) in filterSlots('hint')", :key="name", #[name]="slotProps")
                    slot(:name="name", v-bind="slotProps")
            slot
    // 滚动条仅在对应轴有内容溢出时显示
    ScrollBar(v-if="scrollBar && scrollAxis != 'x' && runtimeData.maxScroll.y > 0", 
        scroll="y", 
        :autoHide="scrollAutoHide",
        :joytick="checkY.has(scrollJoy)", 
        :reverse="checkY.has(scrollReverse)",
        :offset="offsetScrollY",
        :teleport="teleportY"
    )
    ScrollBar(v-if="scrollBar && scrollAxis != 'y' && runtimeData.maxScroll.x > 0", 
        scroll="x", 
        :autoHide="scrollAutoHide",
        :joytick="checkX.has(scrollJoy)", 
        :reverse="checkX.has(scrollReverse)",
        :offset="offsetScrollX",
        :teleport="teleportX"
    )
    Cursor(v-if="midMouseNav && scrollCtrl.midnav?.active", 
        :start="scrollCtrl.midnav.startPos", 
        :pos="scrollCtrl.midnav.cursorPos"
    )